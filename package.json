{
  "name": "medication-adherence-demo",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "lint": "expo lint --no-cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "bundle:android": "expo export --platform android --output-dir dist",
    "build:android:release:verified": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1",
    "build:android:release:x86_64": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1 -Architecture x86_64",
    "build:android:release:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-android-release.ps1 -Architecture arm64-v8a",
    "clean:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local-caches.ps1",
    "clean:local:deep": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local-caches.ps1 -Deep",
    "test:android:native": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android-native-tests.ps1",
    "verify:platform": "node ./scripts/verify-platform-config.mjs",
    "check": "npm run verify:platform && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "expo": "57.0.15",
    "expo-camera": "57.0.4",
    "expo-constants": "57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "57.0.14",
    "expo-file-system": "57.0.5",
    "expo-linking": "57.0.7",
    "expo-notifications": "57.0.13",
    "expo-router": "57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "57.0.7",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.86.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "expo-doctor": "1.20.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
